                className={`group relative flex flex-col bg-white border border-slate-200 shadow-sm hover:shadow-xl rounded-2xl overflow-hidden cursor-pointer hover:border-indigo-300 transition-all duration-500 ${project.span}`}
                onClick={() => setSelectedProject(project)}
                tabIndex={0}
                onKeyDown={(e) => e.key === 'Enter' && setSelectedProject(project)}
              >
                <div className="relative aspect-video w-full overflow-hidden bg-slate-100 border-b border-slate-100">
                  <div className="absolute inset-0 bg-slate-900/5 group-hover:bg-transparent transition-colors z-10"></div>
                  <img 
                    src={project.image} 
                    alt={project.title}
                    className="object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-700 ease-out"
                  />
                </div>

                <div className="flex flex-col flex-grow p-6 relative z-20">
                  <h3 className="text-xl font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors">
                    {project.title}
                  </h3>
                  <p className="text-slate-600 text-sm line-clamp-2 mb-6 flex-grow">
                    {project.description}
                  </p>
                  
                  <div className="flex flex-wrap gap-2 mt-auto">
                    {project.tags.map(tag => (
                      <span key={tag} className="px-2 py-1 bg-slate-100 text-slate-600 font-mono text-[10px] uppercase tracking-wider rounded border border-slate-200">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        {/* 6. CONTACT SECTION */}
        <section id="contact" className="py-32 px-6 bg-slate-100 border-t border-slate-200">
          <div className="max-w-4xl mx-auto">
            <div className="text-center mb-16">
              <h2 className="text-4xl md:text-5xl font-black mb-4 text-slate-900">
                Let's <span className="text-indigo-600">Connect.</span>
              </h2>
              <p className="text-slate-600">Punya ide proyek atau peluang karir? Jangan ragu untuk menyapa.</p>
            </div>

            <form className="space-y-8 bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-slate-200" onSubmit={(e) => e.preventDefault()}>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div className="relative">
                  <input 
                    type="text" 
                    id="name"
                    className="peer w-full bg-transparent border-b-2 border-slate-300 py-3 text-slate-900 focus:outline-none focus:border-indigo-600 placeholder-transparent transition-colors"
                    placeholder="Nama"
                    required
                  />
                  <label htmlFor="name" className="absolute left-0 -top-3.5 text-sm text-slate-500 font-mono transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-slate-400 peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-sm peer-focus:text-indigo-600">
                    // Nama Anda
                  </label>
                </div>
                
                <div className="relative">
                  <input 
                    type="email" 
                    id="email"
                    className="peer w-full bg-transparent border-b-2 border-slate-300 py-3 text-slate-900 focus:outline-none focus:border-indigo-600 placeholder-transparent transition-colors"
                    placeholder="Email"
                    required
                  />
                  <label htmlFor="email" className="absolute left-0 -top-3.5 text-sm text-slate-500 font-mono transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-slate-400 peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-sm peer-focus:text-indigo-600">
                    // Alamat Email
                  </label>
                </div>
              </div>

              <div className="relative mt-8">
                <textarea 
                  id="message"
                  rows="4"
                  className="peer w-full bg-transparent border-b-2 border-slate-300 py-3 text-slate-900 focus:outline-none focus:border-indigo-600 placeholder-transparent transition-colors resize-none"
                  placeholder="Pesan"
                  required
                ></textarea>
                <label htmlFor="message" className="absolute left-0 -top-3.5 text-sm text-slate-500 font-mono transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-slate-400 peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-sm peer-focus:text-indigo-600">
                  // Pesan Anda
                </label>
              </div>

              <div className="flex justify-end pt-4">
                <button 
                  type="submit"
                  className="px-8 py-4 bg-slate-900 text-white hover:bg-indigo-600 rounded-xl font-mono font-bold tracking-wider transition-colors shadow-lg shadow-slate-900/20 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 flex items-center gap-3 group"
                >
                  KIRIM PESAN
                  <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                </button>
              </div>
            </form>
          </div>
